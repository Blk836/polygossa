# Copy to .env for docker compose (and export the same names when running the backend directly).

# Required in production: at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=

# Optional: enables AI definitions, example sentences, translations and the writing tutor (Pro features).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

POSTGRES_PASSWORD=lector

# The app name people see (wordmark, page titles, starter library, Anki exports). Read by the backend and frontend
# (at build time). Blank means Polygossa.
# BRAND_NAME=Polygossa

# Backend only (defaults shown):
# STORAGE_DIR=./data/uploads
# ENFORCE_PLAN_LIMITS=true  # false disables free-tier limits and Pro gating (handy for local development)
# SEED_SAMPLES=true
# DEV_AUTO_LOGIN=true       # allow credential-free login to the test account (forced off in the prod profile)
# CURATOR_TOKEN=            # secret for the bulk video importer (tools/import-videos.mjs); blank turns it off

# Frontend:
# BACKEND_URL=http://localhost:8080
# AUTO_LOGIN=true           # false restores the normal login/sign-up pages
